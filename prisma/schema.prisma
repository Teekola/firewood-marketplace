// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
   provider        = "prisma-client-js"
   previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
   provider   = "postgresql"
   // Uses connection pooling
   url        = env("POSTGRES_PRISMA_URL")
   // Uses direct connection, ⚠️ make sure to keep this to `POSTGRES_URL_NON_POOLING`
   // or you'll have dangling databases from migrations
   directUrl  = env("POSTGRES_URL_NON_POOLING")
   extensions = [postgis]
}

model User {
   id                  String     @id @default(cuid())
   name                String?
   email               String?    @unique
   emailVerified       DateTime?  @map("email_verified")
   image               String?
   isRegistered        Boolean    @default(false) @map("is_registered")
   preferredUnitSystem UnitSystem @default(METRIC)
   buyer               Buyer?
   seller              Seller?
   accounts            Account[]
   sessions            Session[]
   createdAt           DateTime   @default(now()) @map("created_at")
   updatedAt           DateTime   @updatedAt @map("updated_at")
}

enum UnitSystem {
   METRIC
   IMPERIAL
}

model Buyer {
   id                String             @id @default(cuid())
   user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
   userId            String             @unique @map("user_id")
   name              String?
   email             String?
   phone             String?
   countryCode       String?            @map("country_code")
   countryName       String?            @map("country_name")
   postalCode        String?            @map("postal_code")
   city              String?
   address           String?
   quotationRequests QuotationRequest[]
   offerViews        OfferView[]
}

model Location {
   id          String                                @id
   countryCode String                                @map("country_code")
   countryName String                                @map("country_name")
   postalCode  String                                @map("postal_code")
   coordinates Unsupported("geography(Point, 4326)")
   createdAt   DateTime                              @default(now()) @map("created_at")
   updatedAt   DateTime                              @updatedAt @map("updated_at")
   seller      Seller[]

   @@unique([postalCode, countryCode])
}

model Seller {
   id                    String                 @id @default(cuid())
   plan                  Plan
   locationId            String?                @map("location_id")
   location              Location?              @relation(fields: [locationId], references: [id])
   maxDistanceKm         Int                    @default(50) @map("max_distance_km")
   numberOfSentOffers    Int                    @default(0) @map("number_of_sent_offers")
   user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
   userId                String                 @unique @map("user_id")
   offers                Offer[]
   quotationRequests     QuotationRequest[]
   quotationRequestViews QuotationRequestView[]
   createdAt             DateTime               @default(now()) @map("created_at")
   updatedAt             DateTime               @updatedAt @map("updated_at")
}

enum Plan {
   FREE
}

model Offer {
   id                 String           @id @default(cuid())
   quotationRequest   QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
   quotationRequestId String           @map("quotation_request_id")
   seller             Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
   sellerId           String           @map("seller_id")
   createdAt          DateTime         @default(now()) @map("created_at")
   updatedAt          DateTime         @updatedAt @map("updated_at")
   views              OfferView[]
}

model OfferView {
   id           String   @id @default(cuid())
   offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
   offerId      String   @map("offer_id")
   buyer        Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
   buyerId      String   @map("buyer_id")
   lastViewedAt DateTime @default(now()) @map("last_viewed_at")

   @@unique([offerId, buyerId])
}

model QuotationRequest {
   id                    String                 @id @default(cuid())
   buyer                 Buyer                  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
   buyerId               String                 @map("buyer_id")
   offers                Offer[]
   createdAt             DateTime               @default(now()) @map("created_at")
   updatedAt             DateTime               @updatedAt @map("updated_at")
   sellers               Seller[]
   views                 QuotationRequestView[]
   woodType              WoodType
   woodDryness           WoodDryness
   woodAmountCubicMeters Int
   woodMaxLengthCm       Int?
   deliveryMethod        DeliveryMethod
   countryCode           String
   countryName           String
   postalCode            String
   city                  String
   address               String?
   buyerName             String
   buyerEmail            String
   buyerPhone            String
   buyerCompanyName      String?
   additionalInformation String?
}

enum WoodType {
   MIXED
   BIRCH
   PINE
}

enum WoodDryness {
   ANY
   DRY
   GREEN
}

enum DeliveryMethod {
   HOME_DELIVERY
   PICKUP
}

model QuotationRequestView {
   id                 String           @id @default(cuid())
   quotationRequest   QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
   quotationRequestId String           @map("quotation_request_id")
   seller             Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
   sellerId           String           @map("seller_id")
   lastViewedAt       DateTime         @default(now()) @map("last_viewed_at")

   @@unique([quotationRequestId, sellerId])
}

model Account {
   id                String  @id @default(cuid())
   userId            String  @map("user_id")
   type              String
   provider          String
   providerAccountId String  @map("provider_account_id")
   refresh_token     String? @db.Text
   access_token      String? @db.Text
   expires_at        Int?
   token_type        String?
   scope             String?
   id_token          String? @db.Text
   session_state     String?

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@unique([provider, providerAccountId])
}

model Session {
   id           String   @id @default(cuid())
   sessionToken String   @unique @map("session_token")
   userId       String   @map("user_id")
   expires      DateTime
   user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
   identifier String
   token      String
   expires    DateTime

   @@unique([identifier, token])
}
