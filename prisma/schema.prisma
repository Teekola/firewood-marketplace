// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
   provider        = "prisma-client-js"
   previewFeatures = ["driverAdapters", "postgresqlExtensions"]
}

datasource db {
   provider   = "postgresql"
   // Uses connection pooling
   url        = env("POSTGRES_PRISMA_URL")
   // Uses direct connection, ⚠️ make sure to keep this to `POSTGRES_URL_NON_POOLING`
   // or you'll have dangling databases from migrations
   directUrl  = env("POSTGRES_URL_NON_POOLING")
   extensions = [postgis]
}

enum Plan {
   FREE
}

enum SellerQuotationRequestStatus {
   PENDING
   OFFER_SENT
   REJECTED
}

enum QuotationRequestStatus {
   PENDING
   FULFILLED
}

enum WoodType {
   MIXED
   BIRCH
   PINE
}

enum WoodDryness {
   DRY
   GREEN
}

enum DeliveryMethod {
   HOME_DELIVERY
   PICKUP
}

enum UnitSystem {
   METRIC
   IMPERIAL
}

enum Currency {
   EUR
   USD
}

model User {
   id                  String      @id @default(cuid())
   name                String?
   username            String?     @unique
   password            String?
   email               String?     @unique
   emailVerified       DateTime?   @map("email_verified")
   image               String?
   preferredUnitSystem UnitSystem?
   isRegistered        Boolean     @default(false)
   buyer               Buyer?
   seller              Seller?
   accounts            Account[]
   sessions            Session[]
   termsAcceptedAt     DateTime?   @map("terms_accepted_at")
   createdAt           DateTime    @default(now()) @map("created_at")
   updatedAt           DateTime    @updatedAt @map("updated_at")
}

model Buyer {
   id                String             @id @default(cuid())
   user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
   userId            String             @unique @map("user_id")
   name              String?
   email             String?
   phone             String?
   countryCode       String?            @map("country_code")
   countryName       String?            @map("country_name")
   postalCode        String?            @map("postal_code")
   city              String?
   address           String?
   companyName       String?
   longitude         Float?
   latitude          Float?
   quotationRequests QuotationRequest[]
}

model Seller {
   id                 String                   @id @default(cuid())
   plan               Plan
   location           SellerLocation?
   profile            SellerProfile?
   isActive           Boolean                  @default(false) @map("is_active")
   numberOfSentOffers Int                      @default(0) @map("number_of_sent_offers")
   user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
   userId             String                   @unique @map("user_id")
   createdAt          DateTime                 @default(now()) @map("created_at")
   updatedAt          DateTime                 @updatedAt @map("updated_at")
   quotationRequests  SellerQuotationRequest[]
   offers             Offer[]
}

model SellerLocation {
   id            String                                @id @default(cuid())
   countryCode   String                                @map("country_code")
   countryName   String                                @map("country_name")
   postalCode    String                                @map("postal_code")
   city          String
   address       String?
   coordinates   Unsupported("geography(Point, 4326)")
   maxDistanceKm Int                                   @default(50) @map("max_distance_km")
   createdAt     DateTime                              @default(now()) @map("created_at")
   updatedAt     DateTime                              @updatedAt @map("updated_at")
   seller        Seller                                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
   sellerId      String                                @unique @map("seller_id")
}

model SellerProfile {
   id       String  @id @default(cuid())
   seller   Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
   sellerId String  @unique @map("seller_id")
   name     String?
   email    String?
   phone    String?
}

model QuotationRequest {
   id                     String                   @id @default(cuid())
   buyer                  Buyer                    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
   buyerId                String                   @map("buyer_id")
   status                 QuotationRequestStatus
   createdAt              DateTime                 @default(now()) @map("created_at")
   updatedAt              DateTime?                @map("updated_at")
   woodTypes              WoodType[]               @map("wood_type")
   woodDryness            WoodDryness[]            @map("wood_dryness")
   woodAmountCubicMeters  Int                      @map("wood_amount_cubic_meters")
   woodMaxLengthCm        Int?                     @map("wood_max_length_cm")
   deliveryMethods        DeliveryMethod[]         @map("delivery_method")
   countryCode            String                   @map("country_code")
   countryName            String                   @map("country_name")
   postalCode             String                   @map("postal_code")
   city                   String
   address                String?
   buyerName              String                   @map("buyer_name")
   buyerEmail             String                   @map("buyer_email")
   buyerPhone             String                   @map("buyer_phone")
   buyerCompanyName       String?                  @map("buyer_company_name")
   additionalInformation  String?                  @map("additional_information")
   sellerQuotationRequest SellerQuotationRequest[]
   offers                 Offer[]

   @@index(buyerId)
}

model SellerQuotationRequest {
   id                 String                       @id @default(cuid())
   quotationRequest   QuotationRequest             @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
   quotationRequestId String                       @map("quotation_request_id")
   seller             Seller                       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
   sellerId           String                       @map("seller_id")
   lastViewedAt       DateTime?                    @map("last_viewed_at")
   status             SellerQuotationRequestStatus @default(PENDING)

   @@unique([quotationRequestId, sellerId])
   @@index(status)
}

model Offer {
   id                   String           @id @default(cuid())
   quotationRequest     QuotationRequest @relation(fields: [quotationRequestId], references: [id], onDelete: Cascade)
   quotationRequestId   String           @map("quotation_request_id")
   seller               Seller           @relation(fields: [sellerId], references: [id])
   sellerId             String           @map("seller_id")
   price                String
   currency             Currency
   earliestAvailability DateTime         @map("earliest_availability")
   deliveryMethods      DeliveryMethod[] @map("delivery_methods")
   pickupCountryCode    String?          @map("pickup_country_code")
   pickupCountryName    String?          @map("pickup_country")
   pickupPostalCode     String?          @map("pickup_postal_code")
   pickupCity           String?          @map("pickup_city")
   pickupAddress        String?          @map("pickup_address")
   buyerLastSeenAt      DateTime?        @map("buyer_last_seen_at")
   sellerLastSeenAt     DateTime?        @map("seller_last_seen_at")
   acceptedAt           DateTime?        @map("accepted_at")
   rejectedAt           DateTime?        @map("rejected_at")
   createdAt            DateTime         @default(now()) @map("created_at")
   updatedAt            DateTime         @map("updated_at")

   @@index(sellerId)
}

model Account {
   id                String  @id @default(cuid())
   userId            String  @map("user_id")
   type              String
   provider          String
   providerAccountId String  @map("provider_account_id")
   refresh_token     String? @db.Text
   access_token      String? @db.Text
   expires_at        Int?
   token_type        String?
   scope             String?
   id_token          String? @db.Text
   session_state     String?

   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@unique([provider, providerAccountId])
}

model Session {
   id           String   @id @default(cuid())
   sessionToken String   @unique @map("session_token")
   userId       String   @map("user_id")
   expires      DateTime
   user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
   identifier String
   token      String
   expires    DateTime

   @@unique([identifier, token])
}
