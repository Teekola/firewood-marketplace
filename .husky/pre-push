#!/bin/sh
set -euo pipefail

# If this is the first commit, fallback to empty tree
if [ "$(git rev-list --count HEAD)" -eq 1 ]; then
  base_ref=$(git hash-object -t tree /dev/null)
else
  base_ref=HEAD~1
fi

# Get the list of changed files from the last commit (or from empty tree for first commit)
changed_files=$(git diff --name-only "$base_ref" HEAD --diff-filter=ACM || true)

echo "Changed files in the last commit: $changed_files"

# If no files, exit
if [ -z "$changed_files" ]; then
  echo "No relevant changes found. Skipping pre-push checks."
  exit 0
fi

# Filter only ts/js files
changed_files=$(echo "$changed_files" | grep -E '\.(ts|tsx|js|jsx)$' || true)

echo "Filtered changed files: $changed_files"

# Run tests if there are matching files
if [ -n "$changed_files" ]; then
  echo "Running vitest..."
  vitest related --run $changed_files
else
  echo "No relevant changes. Skipping tests."
fi

exit 0
